APP_ENV=local
APP_VERSION=2.2.0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MODEL_NAME=gpt-4o-mini
MODEL_PROVIDER=mock
STORAGE_BACKEND=json
CORS_ORIGINS=https://housun.shop

# Docker 容器内路径；本地直接运行 API 时请使用 STORAGE_PATH=../storage
STORAGE_PATH=/app/storage

JWT_SECRET=geo-production-system-local-secret
JWT_EXPIRE_MINUTES=1440

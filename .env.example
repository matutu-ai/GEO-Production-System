# Docker Compose 会读取根目录 .env；本地运行可使用 backend/.env.example
APP_ENV=production
APP_VERSION=2.2.0

OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
MODEL_PROVIDER=mock
STORAGE_BACKEND=json

# 容器内路径，与 docker-compose.yml 的 storage 挂载保持一致
STORAGE_PATH=/app/storage

JWT_SECRET=geo-production-system-local-secret
JWT_EXPIRE_MINUTES=1440
